// Company KPI Scorecard — data model.
//
// A scorecard is scoped to a FiscalYear (April 1 -> March 31). Within a year the
// KPIs form a hierarchy up to 5 levels deep: Strategic Goal -> KPI -> sub-KPI ->
// sub-sub-KPI -> sub-sub-sub-KPI. Only leaf nodes carry a metric, targets and a
// weight; parents are pure rollups of their children.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MetricType {
  PERCENTAGE
  DOLLAR
  QUANTITY
  DAYS
  MONTH_COMPLETION
}

enum Direction {
  HIGHER_BETTER
  LOWER_BETTER
}

enum TargetMode {
  FIXED
  RANGE
}

// How often a KPI is expected to be reported. Determines only which months it
// is "due" in — a KPI not yet due in a given month joins the not-yet-due
// coverage bucket instead of reading as a reporting gap.
enum Frequency {
  MONTHLY
  QUARTERLY
  ANNUAL
}

// Whether a KPI's annual target is broken into monthly phases so a
// year-to-date figure can be judged against the part of the year that has
// actually elapsed, rather than the full-year target every month.
enum Phasing {
  NONE
  EVEN
  CUSTOM
}

// Whether a recorded figure is settled or still a forecast. An estimate scores
// exactly like an actual; the distinction drives the "provisional" flagging and
// the fallback rule in scoring.ts (use the period's actual, else the most recent
// estimate at or before that period).
enum ValueBasis {
  ACTUAL
  ESTIMATE
}

enum UserRole {
  MEMBER
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

// A named individual account. Replaces the old shared-password login: every
// action taken in the app is now attributable to a real, distinguishable
// user rather than a free-text "author" string typed by whoever was signed
// in.
model User {
  id              String     @id @default(cuid())
  username        String     @unique
  passwordHash    String
  companyIdNumber String     @unique
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])
  role            UserRole   @default(MEMBER)
  status          UserStatus @default(PENDING)

  proposals         KpiChangeProposal[] @relation("ProposedBy")
  reviewed          KpiChangeProposal[] @relation("ReviewedBy")
  scoreOverrides    ScoreOverride[]
  closedFiscalYears FiscalYear[]        @relation("ClosedFiscalYears")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
}

// A department member's proposed change to a leaf KPI's settings, held for
// admin approval rather than applied immediately. Mirrors the shape of a
// writeKpiSettings call (payload) plus the human-readable diff already built
// for the audit trail (summary), so approval can reuse both without
// recomputing them.
model KpiChangeProposal {
  id           String @id @default(cuid())
  kpiId        String
  kpi          Kpi    @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  proposedById String
  proposedBy   User   @relation("ProposedBy", fields: [proposedById], references: [id])

  payload String // JSON: the SaveKpiSettingsInput this would apply
  summary String // JSON: FieldChange[] for display in the approvals queue

  // The KPI's updatedAt at proposal time. Re-checked at approval — if the
  // KPI changed since (another proposal landed, or an admin edited it
  // directly), approval is refused rather than applied over a stale base.
  baseUpdatedAt DateTime

  status       ProposalStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?          @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewNote   String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([kpiId, status])
}

// Backs the rate limit on the live username-status check at login. One row
// per check attempt, keyed by a hash of the caller's IP (never the raw IP) —
// this only needs to answer "how many recently," not who exactly.
model UsernameCheckAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

// One financial year, April of `startYear` through March of `startYear + 1`.
// Each year owns its own hierarchy, weights and targets, so changing next
// year's targets never rewrites last year's scores.
model FiscalYear {
  id        String  @id @default(cuid())
  startYear Int     @unique
  label     String
  isActive  Boolean @default(false)

  // Set once the year's numbers are board-approved and frozen. While set,
  // every write action on this year's KPIs (figures, settings, structure)
  // is refused — see assertFiscalYearOpen in src/lib/validation.ts.
  closedAt   DateTime?
  closedById String?
  closedBy   User?     @relation("ClosedFiscalYears", fields: [closedById], references: [id])

  kpis     Kpi[]
  snapshot FiscalYearSnapshot?
  audits   FiscalYearAudit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per KPI per month a score was manually calibrated by an admin.
// Applied at scoring time (kpi-tree.ts), layered on top of the computed
// leaf score — the computed value is never discarded, just overridden for
// display and for every rollup above it.
model ScoreOverride {
  id        String   @id @default(cuid())
  kpiId     String
  kpi       Kpi      @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  period    String // "YYYY-MM"
  score     Float // 0-5, replaces the computed score for this KPI/period
  reason    String
  byId      String
  by        User     @relation(fields: [byId], references: [id])
  createdAt DateTime @default(now())

  @@unique([kpiId, period])
  @@index([kpiId])
}

// The full computed scorecard at the moment a fiscal year is closed, so a
// closed year renders from this instead of recomputing live — protecting a
// board-approved historical year from ever moving under a future change to
// the scoring engine itself. One row per fiscal year; overwritten if the
// year is reopened and re-closed.
model FiscalYearSnapshot {
  id           String     @id @default(cuid())
  fiscalYearId String     @unique
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  // JSON: { [period]: { [kpiId]: { score, exactScore, band, coverage,
  // provisional, prorated, weight, globalWeight } } } for every period of
  // the year.
  data String

  createdAt DateTime @default(now())
}

// Fiscal-year-level events (closed / reopened) — the year-level analogue of
// KpiAudit, which is keyed to a specific KPI and doesn't fit here.
model FiscalYearAudit {
  id           String     @id @default(cuid())
  fiscalYearId String
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  action String // "closed" | "reopened"
  reason String?
  author String // username, server-derived

  createdAt DateTime @default(now())

  @@index([fiscalYearId, createdAt])
}

// Owner of a KPI. Departments, not individuals — picked from a managed dropdown.
model Department {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(true)

  kpis  KpiDepartment[]
  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Kpi {
  id           String     @id @default(cuid())
  fiscalYearId String
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  // Stable human-readable identifier, unique within the year. Used as the join
  // key for spreadsheet import (`Parent Code` refers to it).
  code String
  name String

  parentId String?
  parent   Kpi?    @relation("KpiHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Kpi[]   @relation("KpiHierarchy")

  sortOrder Int @default(0)

  // Local weight: a KPI's share of its own siblings, summing to 100 within
  // each sibling group (roots included). Every node carries one, parents
  // included — a parent's local weight is its share of its own siblings, not
  // a rollup. The company-wide ("global") weight is derived top-down from
  // these at read time (see kpi-tree.ts) and is never stored.
  weight Float @default(0)

  // How often this KPI is expected to be reported. Leaf-only; determines only
  // which months it counts as "due" in.
  frequency Frequency @default(MONTHLY)

  // Whether this KPI's annual target is phased across the year for pro-rating.
  // Leaf-only, and only meaningful for a numeric metric — always NONE for
  // MONTH_COMPLETION.
  phasing Phasing @default(NONE)

  // CUSTOM only: JSON array of 12 monthly shares (April first), summing to
  // ~100. Warned, never blocked, when they don't — same tolerance as weights.
  phaseConfig String?

  // --- Leaf-only fields. Null on rollup nodes, whose score is the weighted
  // average of their children. ---

  metricType MetricType?
  direction  Direction?
  targetMode TargetMode?
  unit       String?

  // JSON-encoded targets; the shape depends on metricType/targetMode.
  //   FIXED numeric:  { poor, improvementNeeded, meet, good, veryGood, excellent }
  //   RANGE numeric:  { poor: [min,max], improvementNeeded: [min,max], ... }
  //   MONTH_COMPLETION: { targetMonth: "YYYY-MM" }
  targetConfig String?

  // Optional deadline for KPIs that are time-bound even though their metric is
  // not time-based. "YYYY-MM", meaning the last day of that month. Ignored for
  // MONTH_COMPLETION, which already carries a target month.
  deadlineMonth String?

  // true  -> the score freezes at its deadline-month value; later achievement
  //          is recorded but never changes the score.
  // false -> later achievement still earns partial credit, capped by how late
  //          it is (see applyDeadline in scoring.ts).
  scoreFinalAfterDeadline Boolean @default(false)

  departments KpiDepartment[]
  values      KpiValue[]
  updates     KpiUpdate[]
  audits      KpiAudit[]
  proposals   KpiChangeProposal[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  scoreOverrides ScoreOverride[]

  @@unique([fiscalYearId, code])
  @@index([fiscalYearId])
  @@index([parentId])
}

// A time-stamped record of a definition change: a target, metric type,
// weight, code or structural move. Written in the same transaction as the
// change it records, so a row can never claim something that did not happen.
// A deleted KPI's own audits cascade away with it, so structural actions
// (move, delete) that concern a KPI's place in the tree are recorded against
// its *parent* as well, so there is still a trace once the child is gone.
model KpiAudit {
  id    String @id @default(cuid())
  kpiId String
  kpi   Kpi    @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  field String // "targets", "metricType", "weight", "code", "parentId", "deleted"…
  label String // the human label already shown in the confirmation dialog
  from  String
  to    String

  author String? // free text, as KpiUpdate already does — there are no user accounts

  createdAt DateTime @default(now())

  @@index([kpiId, createdAt])
}

// Many-to-many: a KPI can be owned by several departments.
model KpiDepartment {
  kpiId        String
  kpi          Kpi        @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([kpiId, departmentId])
  @@index([departmentId])
}

// One month's recorded figure for a leaf KPI.
model KpiValue {
  id    String @id @default(cuid())
  kpiId String
  kpi   Kpi    @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  // The month this figure reports, "YYYY-MM".
  period String

  // Cumulative year-to-date figure (or the latest estimate of it) for numeric
  // metrics. Null for MONTH_COMPLETION, which records a date instead.
  value Float?
  basis ValueBasis @default(ACTUAL)

  completionDate DateTime?

  // Commentary on this month's number specifically. Longer-running narrative
  // belongs in KpiUpdate.
  note String?

  enteredAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kpiId, period])
  @@index([kpiId])
}

// Free-form status updates shown as a history on the KPI detail page.
model KpiUpdate {
  id    String @id @default(cuid())
  kpiId String
  kpi   Kpi    @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  // The month the update relates to, "YYYY-MM".
  period String
  body   String
  author String?

  createdAt DateTime @default(now())

  @@index([kpiId, createdAt])
}
