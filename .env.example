# Copy this file to `.env` and fill in your own values.

# --- Database -------------------------------------------------------------
# Both strings come from your Supabase project:
# Project Settings -> Database -> Connection string

# "Transaction pooler" string (port 6543) — used by the running app.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# "Session pooler" string (port 5432) — used only when running migrations.
#
# NOT the option Supabase literally labels "Direct connection"
# (db.[PROJECT-REF].supabase.co:5432) — that host is IPv6-only and will fail
# with "P1001: Can't reach database server" on most home/office networks.
# Session pooler behaves like a direct connection for our purposes but works
# over IPv4. Same hostname as DATABASE_URL above, just a different port.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"

# --- Access ---------------------------------------------------------------
# Individual accounts are registered in the app (/register) — the first
# account created is auto-approved and made an admin, everyone after that
# waits for an admin to approve them. Nothing to configure here.

# Secret used to sign the session cookie. Any long random string; generate one
# with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
SESSION_SECRET="a-long-random-string"
